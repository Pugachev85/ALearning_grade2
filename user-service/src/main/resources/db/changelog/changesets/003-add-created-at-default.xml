<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">

    <changeSet id="003-add-created-at-default" author="ALearning_grade2">
        <comment>Добавление значения по умолчанию для поля created_at</comment>

        <addDefaultValue tableName="users" columnName="created_at"
                         defaultValueComputed="CURRENT_TIMESTAMP"/>

        <rollback>
            <dropDefaultValue tableName="users" columnName="created_at"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
